{
  "version": 1,
  "source": "orca-fleet-topology.svg (orca 1.4.237, Windows, local)",
  "lanes": [
    { "lane": "W1", "cli": "codex", "model": "gpt-6.1 sol", "role": "core implementation", "wt": "wt/core", "delivery": "argv", "observe": {"argv": ["codex", "exec", "--skip-git-repo-check", "{prompt}"]} },
    { "lane": "W2", "cli": "opencode", "model": "minimax-3.1", "role": "API & integration", "wt": "wt/api", "delivery": "flag-prompt", "observe": {"argv": ["opencode", "run", "{prompt}"]} },
    { "lane": "W3", "cli": "antigravity", "model": "gemini-3.8-flash", "role": "UI & frontend", "wt": "wt/ui", "note": "binary agy, not on PATH", "observe": {"argv": ["agy", "-p", "{prompt}"], "argvByPlatform": {"linux": ["script", "-qec", "agy -p \"Reply with exactly: OK\"", "/dev/null"], "darwin": ["script", "-q", "/dev/null", "agy", "-p", "{prompt}"]}, "note": "agy needs a TTY on Linux/macOS"} },
    { "lane": "W4", "cli": "pi", "model": "nemotron-ultra-550", "role": "tests & CI", "wt": "wt/tests", "note": "not on PATH", "observe": {"argv": ["pi", "-p", "{prompt}"]} },
    { "lane": "W5", "cli": "grok", "model": "grok 4.7", "role": "perf & refactor", "wt": "wt/perf", "observe": {"argv": ["grok", "-p", "{prompt}"]} },
    { "lane": "W6", "cli": "muse", "model": "muse wonder", "role": "docs & migration", "wt": "wt/docs", "observe": {"argv": ["muse", "exec", "{prompt}"]} },
    { "lane": "W7", "cli": "dsh", "model": "deepseek-flash-4.1-107", "role": "long-tail fixes", "wt": "wt/tail", "note": "binary dsh-tui", "observe": {"argv": ["dsh", "--profile", "headless", "{prompt}"], "argvByPlatform": {"win32": ["dsh-tui", "--profile", "headless", "{prompt}"]}} },
    { "lane": "C", "cli": "claude", "model": "claude", "role": "coordinator: architect & run owner", "observe": {"argv": ["claude", "-p", "{prompt}"]} },
    { "lane": "B", "cli": "hermes", "model": "hermes", "role": "context broker: recall & spec lint", "observe": {"argv": ["hermes", "--oneshot", "{prompt}"]} },
    { "lane": "T", "cli": "jev", "model": "jev", "role": "triage & classify before Claude spends", "observe": {"argv": ["gate-push", "-C", "{repo}", "{brief}", "{base}", "{head}", "--all", "--no-tests"], "fixture": "git", "env": {"JEV_LOG": "{tmp}/gate.jsonl"}, "note": "jev is the gate-push script; a throwaway repo makes it ask the model once"} }
  ]
}
